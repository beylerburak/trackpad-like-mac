[Unit]
Description=macOS-style touchpad gestures (trackpad-like-mac)
Documentation=https://github.com/beylerburak/trackpad-like-mac

[Service]
ExecStart=@LIBDIR@/trackpad-like-mac-daemon
Restart=always
RestartSec=2
# Gestures are streamed over a socket in /run/trackpad-like-mac.
RuntimeDirectory=trackpad-like-mac
RuntimeDirectoryMode=0755

# Needs only to read touchpads and write /dev/uinput, both owned by root.
CapabilityBoundingSet=
NoNewPrivileges=yes
DevicePolicy=closed
DeviceAllow=char-input r
DeviceAllow=/dev/uinput rw
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
